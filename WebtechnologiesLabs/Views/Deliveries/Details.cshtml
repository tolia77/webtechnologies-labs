@model WebtechnologiesLabs.Models.Delivery

@{
    ViewData["Title"] = "Delivery details";
}

<h1>Delivery details</h1>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PickupAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PickupAddress)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DropoffAddress)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DropoffAddress)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PackageDescription)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PackageDescription)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Weight)
