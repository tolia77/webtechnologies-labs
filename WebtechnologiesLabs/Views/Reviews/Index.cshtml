@model IEnumerable<WebtechnologiesLabs.Models.Review>

@{
    ViewData["Title"] = "Reviews";
    var isSignedIn = User.Identity!.IsAuthenticated;
    var canModerate = User.IsInRole("Administrator") || User.IsInRole("Moderator");
}

<h1>Reviews</h1>

@if (isSignedIn)
{
    <p>
        <a class="btn btn-primary" asp-action="Create">Add review</a>
    </p>
}
<div class="dt-card table-responsive">
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Text)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            @if (isSignedIn)
            {
                <th>
                    @Html.DisplayNameFor(model => model.Delivery)
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Text)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            @if (isSignedIn)
            {
                <td>
                    @Html.DisplayFor(modelItem => item.Delivery.Title)
                </td>
            }
            <td>
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (canModerate)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
</div>
