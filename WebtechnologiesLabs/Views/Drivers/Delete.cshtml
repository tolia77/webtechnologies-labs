@model WebtechnologiesLabs.Models.Driver

@{
    ViewData["Title"] = "Delete driver";
}

<h1>Delete driver</h1>

<div class="alert alert-warning">Are you sure you want to delete this driver?</div>
<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.FirstName)
