# Copy to .env before the first `docker compose up`. .env is gitignored, this file is not.

APP_PORT=8081
DB_PORT=5433

POSTGRES_DB=drivetrack
POSTGRES_USER=drivetrack
POSTGRES_PASSWORD=drivetrack-local-password

# used by the app inside docker; `db` is the compose service name
ConnectionStrings__DriveTrackContext=Host=db;Port=5432;Database=drivetrack;Username=drivetrack;Password=drivetrack-local-password
